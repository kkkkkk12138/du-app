{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "du-1-d0gfhmkfe81e2d8e8",
  "region": "ap-shanghai",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "media-reserve-upload",
      "description": "Reserve free media capacity before encrypted COS uploads",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "media-create-upload-ticket",
      "description": "Validate media reservations and issue short-lived COS PUT URLs",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "COS_BUCKET": "{{env.COS_BUCKET}}",
        "COS_REGION": "ap-shanghai"
      }
    }
  ],
  "database": {
    "type": "postgresql",
    "migrations": "./cloudbase/migrations"
  }
}
